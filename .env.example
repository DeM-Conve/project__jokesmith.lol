# jokesmith.lol self-hosting config: copy to .env, edit, then `docker compose up -d --build`.
# Every value is optional; the defaults below are what you get with no .env at all.

# --- URL and ports -------------------------------------------------------------
# Public base URL the browser uses (scheme + host + port, no trailing slash).
# Behind a reverse proxy with TLS, e.g. https://jokesmith.example.com
JOKESMITH_URL=http://localhost:8200
# Host interface and port the frontend (nginx) is published on. The browser only ever
# talks to this container; it proxies /api to the backend.
# Defaults to loopback (as before) so nothing is exposed by surprise: set 0.0.0.0 to reach
# it from the LAN, keep 127.0.0.1 behind a reverse proxy on the same host.
JOKESMITH_BIND=127.0.0.1
JOKESMITH_PORT=8200

# --- Database ------------------------------------------------------------------
# Set a real password before first start. Changing it later does not change the password
# of an already initialised database (use ALTER USER inside Postgres for that).
DB_PASSWORD=jokesmith
DB_USERNAME=jokesmith
DB_DATABASE_NAME=jokesmith
# Development only (docker-compose.dev.yml): host interface and port Postgres is published
# on for `mvn spring-boot:run`. The self-hosted stack does not publish Postgres at all.
DB_BIND=127.0.0.1
DB_PORT=5433

# --- Data location -------------------------------------------------------------
# Where Postgres keeps its data. A bare name ("pgdata") is a Docker named volume;
# a path (./data/pgdata, /srv/jokesmith/pgdata) is a bind mount on the host.
DB_DATA_LOCATION=pgdata

# --- Optional ------------------------------------------------------------------
# Server time zone (backend + Postgres logs, "today" for the daily riff prompt bounds).
# Streaks and the daily plan already use each browser's own time zone.
TZ=UTC
